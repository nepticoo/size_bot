# Copy this file to .env. NEVER commit .env.
# You do not fill this in by hand: the assistant derives it from docs/profile.md
# and secrets/secrets.local.md.

# --- where this project runs locally ---
APP_PORT=8000
APP_URL=http://localhost:8000

# --- app ---
SECRET_KEY=

# --- database: one SQLite file inside the project ---
# Every query goes through SQLAlchemy and every schema change through Alembic,
# so moving to PostgreSQL later is this one line and nothing else.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- uploaded files ---
UPLOADS_DIR=./uploads

# --- initial admin (the assistant generates this and hands it to you) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- business dependencies (derived from secrets/secrets.local.md) ---
# only the ones this product actually uses, for example:
# BALE_BOT_TOKEN=
# EITAA_TOKEN=
